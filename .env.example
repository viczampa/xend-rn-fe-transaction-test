# Copy this file to `.env` and fill in the values before running the app.
# Every key is read by the Expo runtime via process.env.

EXPO_PUBLIC_API_URL=https://dev.xendora.com/api
EXPO_PUBLIC_API_PROD_URL=https://xendora.com/api

EXPO_PUBLIC_TEST_USER_EMAIL=
EXPO_PUBLIC_TEST_USER_PASSWORD=

# Optional: public URL to Metro when using cloudflared/ngrok (see README).
# Example: EXPO_PACKAGER_PROXY_URL=https://abc-xyz.trycloudflare.com
# EXPO_PACKAGER_PROXY_URL=
